APP_NAME="Galpon de Empaque"
APP_ENV=local
APP_KEY=
# En el servidor del galpón: APP_ENV=production y APP_DEBUG=false (ver docs/INSTALACION.md).
APP_DEBUG=true
# IP fija o nombre con el que entran las otras PCs: se usa en el QR de los remitos y en los emails.
APP_URL=http://192.168.1.100
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galpon
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=America/Argentina/Buenos_Aires
GALPON_INSTALLATION_ID=local-dev
# IP del proxy inverso si lo hay (ej. 127.0.0.1). Vacío = el servidor recibe las conexiones directamente.
GALPON_TRUSTED_PROXIES=
# Carpeta de mysqldump/mysql para los backups (XAMPP: C:\xampp\mysql\bin).
GALPON_MYSQL_BIN=

# --- ARCA (ex AFIP). Nunca subir certificados ni claves al repositorio. ---
ARCA_CUIT=
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_KEY_PASSPHRASE=

# --- Integraciones opcionales ---
GALPON_SCALE_DRIVER=manual
GALPON_LABEL_PRINTER=browser
GALPON_WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GALPON_SUPPORT_EMAIL=soporte@example.com
