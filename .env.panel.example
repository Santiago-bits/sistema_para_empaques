# Panel General EN TU PC (para probar antes de subir a Hostinger).
# Copiar como .env.panel (scripts\preparar-panel-local.bat lo hace solo).
# Corre en http://127.0.0.1:8001 con su propia base de datos (galpon_panel), al lado del galpón (localhost:8000).
APP_NAME="Panel General"
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galpon_panel
DB_USERNAME=root
DB_PASSWORD=

# Cookie de sesión propia: así podés estar logueado en el galpón y en el panel a la vez.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_COOKIE=panel_general_session
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

GALPON_INSTALLATION_ID=panel-local
GALPON_CENTRAL_MODE=true
GALPON_MYSQL_BIN=C:\xampp\mysql\bin
